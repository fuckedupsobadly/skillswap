# --- Required in production -------------------------------------------------
# Postgres (Neon). Leave unset locally: the app falls back to embedded PGlite in ./.pglite
DATABASE_URL=
# Neon's direct (non-pooled) connection, used for migrations at build time. Set by the Neon integration.
DATABASE_URL_UNPOOLED=
# Connections per server instance (default 5)
DATABASE_POOL_MAX=
# 32+ random bytes, used to sign session cookies and challenges, and to encrypt email addresses
APP_SECRET=

# --- Optional hosted services (each has a labelled local fallback) -------------
# Vercel AI Gateway (Claude for the concierge). On Vercel, OIDC works without a key.
AI_GATEWAY_API_KEY=
# Inngest durable jobs. Without keys, outbox events are dispatched in-process.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Upstash Redis rate limits. Without these, an in-memory limiter is used per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Protects /api/cron/sweep (Vercel Cron sends it as a bearer token)
CRON_SECRET=
# Video rooms
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
